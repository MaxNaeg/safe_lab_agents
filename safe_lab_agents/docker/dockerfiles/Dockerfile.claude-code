# =============================================================================
# Dockerfile for the Claude Code agent
#
# Installs Node.js (for Claude Code CLI), Python 3 with common scientific
# packages, and the Claude Code CLI.  The entrypoint script handles
# MCP configuration and launching the agent.
# =============================================================================

FROM node:22-slim

LABEL maintainer="safe_lab_agents"
LABEL agent="claude-code"
# Capability marker: this image's entrypoint can resume a session autonomously
# (`agent resume --task`). Committed session images inherit it, so the host can
# tell them apart from older sessions whose baked-in entrypoint cannot.
LABEL safe_lab_agents.autonomous_resume="1"

# ---- System dependencies ----
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
        git \
        curl \
        ca-certificates \
        iptables \
        util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/python3 /usr/local/bin/python

# ---- Non-root user ----
# Created here (before the Claude install) so the installer runs as 'agent'
# and places the binary in /home/agent/.local/bin — the location that is
# both writable during build and on PATH at runtime.
RUN useradd -m -s /bin/bash agent \
    && mkdir -p /home/agent/.local/bin /home/agent/.claude \
                /agent/workspace /agent/context /agent/shared \
    && chown -R agent:agent /home/agent /agent

# ---- Claude Code CLI ----
# Pinned to a version the end-to-end tests were run against. Claude Code ships
# several releases a week and they do change behaviour (permission handling,
# resume, headless defaults), so an unpinned install means any image rebuild can
# silently change how sessions behave. Bump the default below deliberately,
# after re-running the e2e suite; override per session with
# `agent start --agent-version <version|latest|stable>`.
ARG AGENT_VERSION=2.1.332
# Run as 'agent' (via su -l) so HOME=/home/agent and the binary lands in
# /home/agent/.local/bin/claude, accessible to the same user at runtime.
# CI=true suppresses interactive prompts in the installer. `su -l` resets the
# environment, so the version is expanded here by the build shell.
RUN su -l agent -c "CI=true curl -fsSL https://claude.ai/install.sh | bash -s -- '${AGENT_VERSION}'"
# Keep the installed version: without this the CLI updates itself in the
# background at runtime, which would undo the pin inside a running session (and
# in the image committed from it).
ENV DISABLE_AUTOUPDATER=1

# ---- Python scientific stack (default packages) ----
RUN python3 -m pip install --break-system-packages --no-cache-dir \
        numpy \
        pandas \
        matplotlib \
        scipy \
        h5py

# ---- Optional: user-supplied requirements ----
# When building with --build-arg REQUIREMENTS_FILE=requirements.txt,
# this layer installs additional Python packages.
ARG REQUIREMENTS_FILE=""
COPY ${REQUIREMENTS_FILE:-.dockerignore} /tmp/user_requirements.txt
RUN if [ -s /tmp/user_requirements.txt ] && [ "$REQUIREMENTS_FILE" != "" ]; then \
        python3 -m pip install --break-system-packages --no-cache-dir \
            -r /tmp/user_requirements.txt; \
    fi && rm -f /tmp/user_requirements.txt

# ---- Entrypoint + egress-firewall scripts ----
COPY entrypoint.claude-code.sh /entrypoint.sh
COPY firewall.sh /firewall.sh
RUN chmod +x /entrypoint.sh /firewall.sh

# No USER directive: the container starts as root so the entrypoint can apply
# the egress firewall (CAP_NET_ADMIN), then drops to 'agent' via setpriv.

# The Claude Code installer places the binary in ~/.local/bin.
ENV PATH="/home/agent/.local/bin:${PATH}"

# ---- Toolchain provenance ----
# The Claude Code version is selectable (AGENT_VERSION may be "latest"), so
# record what was actually installed. Placed last so it never invalidates the
# expensive layers above. Read back with:
#   docker run --rm --entrypoint cat <image> /image-versions.txt
RUN su -l agent -c '/home/agent/.local/bin/claude --version' > /image-versions.txt \
    && cat /image-versions.txt

WORKDIR /agent/workspace

ENTRYPOINT ["/entrypoint.sh"]
